# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# 이동 시간 도구(카카오맵 REST API 키). 비워 두면 그 도구만 꺼진다
KAKAO_REST_KEY=

# 크레딧 결제(토스페이먼츠 주문서형 결제). 둘 중 하나라도 비우면 결제만 꺼진다
# 결제위젯 연동 테스트 키 한 쌍을 넣는다(test_gck_ 로 시작하는 것, test_gsk_ 로 시작하는 것).
# test_ 로 시작하지 않는 키(라이브 키)면 앱이 시작하지 않는다. 시크릿 키는 서버에서만 쓰고 화면에 나가지 않는다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Langfuse 관측(선택). 공개 키와 비밀 키가 둘 다 있어야 켜진다
# 주소는 가입할 때 고른 지역의 것을 넣는다. 미국 https://us.cloud.langfuse.com, 유럽 https://cloud.langfuse.com(비우면 유럽)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
